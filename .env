VITE_APP_NAME=PANSA
VITE_PROXY_BASE=https://pansa.example.com
VITE_PROXY_BACKEND=/netshort
VITE_DEFAULT_LANG=id_ID

# Resolusi player yang tersedia (Effect 2, VIP bebas akses)
VITE_PLAYER_RESOLUTIONS=540p,720p,1080p

# Enable route transition & motion effect
VITE_MOTION_EFFECT=2
VITE_STAGGER_DELAY=0.06

# Aset CDN (optional)
VITE_CDN_FONTS=google